# Base URL of the public archive API (Feathers-style /streams, /vods …). Optional; defaults to the public one.
VITE_ARCHIVE_API=https://vods.example.net/backend
# vexoulz-auth, the sign-in shared by the *.vexoul.net sites (default: off). Empty turns sign-in off.
VITE_AUTH_BASE=https://auth.example.net
